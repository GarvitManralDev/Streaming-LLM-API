# Copy this file to `.env` and change the values.
# `.env` is git-ignored - this example file is safe to commit.

APP_NAME=Production Streaming LLM API
ENVIRONMENT=development

# Clients must send this in the X-API-Key header
API_KEY=course-secret

LLM_MODEL=demo-model

# Max requests per API key inside the window
RATE_LIMIT=10
RATE_WINDOW_SECONDS=60
